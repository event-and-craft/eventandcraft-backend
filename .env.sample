# App Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=eventcraft_db
DB_PGSSLMODE=require

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket

# JWT Configuration
JWT_ACCESS_TOKEN_SECRET_KEY=your-access-token-secret-key
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_SECRET_KEY=your-refresh-token-secret-key
JWT_REFRESH_TOKEN_EXPIRY=7d

# Mailer Configuration
MAIL_HOST=your-smtp-host
MAIL_USER=your-smtp-user
MAIL_PASS=your-smtp-password

# Swagger Documentation
SWAGGER_DOC_URL=doc

# Admin Credentials
ADMIN_PASSWORD=admin123

# Media Server Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_SERVICE_ACCOUNT_KEY_PATH=./keys/gcp-service-account.json
GCS_PRODUCTION_BUCKET=your-gcs-bucket
GCS_SIGNED_URL_EXPIRY_SECONDS=900
WATERMARK_TEXT="© EventCraft"
